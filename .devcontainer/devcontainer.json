{
    "name": "careBT",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends graphviz && pip install -e . && pip install pytest coverage build twine && pip install -r docs/requirements.txt",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "careBT docs",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.testing.pytestArgs": ["tests", "-s", "-vv"],
                "python.testing.unittestEnabled": false,
                "python.testing.pytestEnabled": true
            },
            "extensions": [
                "ms-python.python"
            ]
        }
    }
}
